rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regras para serviços (Público pode ler, manicure autenticada pode editar)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regras para configurações do estúdio (Público pode ler horário e endereço)
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regras para agendamentos (Público pode ler horários e criar agendamento)
    match /appointments/{appointmentId} {
      allow read: if true;
      allow create: if request.resource.data.clientName is string
                    && request.resource.data.clientPhone is string
                    && request.resource.data.startTime is string;
      allow update, delete: if request.auth != null;
    }

    // Ficha de clientes: público pode criar/atualizar no agendamento; apenas manicure pode listar/ler
    match /clients/{clientId} {
      allow create, update: if true;
      allow read, delete: if request.auth != null;
    }

    match /transactions/{transactionId} {
      allow read, write: if request.auth != null;
    }
  }
}
